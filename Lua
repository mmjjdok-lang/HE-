		img:Destroy()
		New("TextLabel", { Size = UDim2.fromScale(1, 1), Text = o.Text or "+", Font = FONT_BOLD, TextSize = 22, Parent = tile })
	end
	local hit = New("TextButton", { Size = UDim2.fromScale(1, 1), ZIndex = 3, Parent = tile })
	local token = 0
	local function blink() -- white border blinks
		token = token + 1
		local my = token
		task.spawn(function()
			st.Thickness = 2.5
			for _ = 1, 3 do
				if my ~= token or not st.Parent then
					return
				end
				st.Transparency = 0
				task.wait(0.09)
				st.Transparency = 0.8
				task.wait(0.09)
			end
			if my == token and st.Parent then
				st.Thickness = 1
				tw(st, 0.2, { Transparency = 0.9 })
			end
		end)
	end
	hit.MouseEnter:Connect(function()
		tw(tile, 0.15, { BackgroundColor3 = State.Theme.ElementHover })
	end)
	hit.MouseLeave:Connect(function()
		tw(tile, 0.15, { BackgroundColor3 = State.Theme.Element })
	end)
	attachTooltip(hit, o.Tooltip or o.Name)
	local function fire()
		blink()
		playSound()
		safeCall(o.Callback)
	end
	hit.Activated:Connect(fire)
	local entry = win:_RegisterBind({
		Name = o.Name or ("Image " .. self.TileCount), Kind = "Button", Keybind = o.Keybind,
		Fire = function()
			blink()
			safeCall(o.Callback)
		end,
	})
	entry.Row, entry.Tab = tile, self
	return { Frame = tile, Fire = fire }
end

