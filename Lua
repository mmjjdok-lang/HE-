local function buildRow(self, o, rightReserve, nameReserve)
	local row = New("Frame", { BackgroundColor3 = State.Theme.Element, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, ClipsDescendants = true })
