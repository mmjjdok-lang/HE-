				New("TextLabel", {
					Position = UDim2.fromOffset(34, 0), Size = UDim2.new(1, -34, 1, 0), TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd, RichText = true, TextSize = 12,
					Text = string.format('%s  <font size="9" color="#888888">%s</font>', e.Name, string.upper(e.Kind)), Parent = run,
				})
				run.MouseEnter:Connect(function()
					tw(r, 0.15, { BackgroundColor3 = State.Theme.ElementHover })
				end)
				run.MouseLeave:Connect(function()
					tw(r, 0.15, { BackgroundColor3 = State.Theme.Element })
				end)
				run.InputBegan:Connect(function(i)
					if isPress(i) then
						ripple(r, i.Position.X, i.Position.Y)
					end
				end)
				run.Activated:Connect(function()
					win:_PressEntry(e, "panel")
				end)

				local kbg = New("Frame", { BackgroundColor3 = State.Theme.Panel, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(46, 26), Parent = r })
				corner(kbg, R_BTN)
				stroke(kbg, WHITE, 1, 0.88)
				local box = New("TextBox", {
					Size = UDim2.fromScale(1, 1), Font = FONT_BOLD, TextSize = 11, PlaceholderText = "+", PlaceholderColor3 = State.Theme.SubText,
					Text = e.Key and shortKeyName(e.Key) or "", TextTruncate = Enum.TextTruncate.AtEnd, ClearTextOnFocus = false, Parent = kbg,
				})
				box.Focused:Connect(function()
					box.Text = ""
				end)
				box.FocusLost:Connect(function()
					local txt = box.Text:gsub("%s", "")
					if txt == "" then
						if e.Key then
							e.Key, e.Enabled = nil, false
						end
					else
						local k = toKey(txt)
						if not k then
							HE:Notify({ Title = "Shortcut", Content = "Unknown key: " .. txt, Type = "Warning", Duration = 2.5 })
						else
							local owner
							for _, o2 in ipairs(win.Binds) do
								if o2 ~= e and o2.Key == k then
									owner = o2
									break
								end
							end
							if owner then
								HE:Notify({ Title = "Shortcut", Content = shortKeyName(k) .. " is already used by \"" .. owner.Name .. "\".", Type = "Warning", Duration = 3 })
							else
								e.Key, e.Enabled = k, true
							end
						end
					end
					win:_RefreshChips()
					win:_Changed()
				end)

				local isToggle = e.GetState ~= nil
				local on = isToggle and e.GetState() or false
				local sw = New("TextButton", {
					BackgroundTransparency = 0, BackgroundColor3 = on and State.Accent or State.Theme.Panel, AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -60, 0.5, 0), Size = UDim2.fromOffset(44, 26), Text = isToggle and (on and "ON" or "OFF") or "RUN",
					TextSize = 11, Font = FONT_BOLD, TextColor3 = on and BLACK or WHITE, Parent = r,
				})
				corner(sw, R_BTN)
				sw.Activated:Connect(function()
					win:_PressEntry(e, "panel")
				end)
			end
		end
		if n == 0 then
			New("TextLabel", { Size = UDim2.new(1, 0, 0, 30), Text = (#win.Binds == 0) and "No Buttons or Toggles registered yet." or "No matching shortcuts.", TextColor3 = State.Theme.SubText, Parent = scroll })
		end
	end

	connect(search:GetPropertyChangedSignal("Text"), function()
		filter = string.lower(search.Text)
		win.KBRefresh()
	end)
	win.KBRefresh()
	frame.Visible = true
end

-- ============================================================
-- FOLDERS (dropdown next to the title)
--   "+ Add Folder"  -> type a name, the folder is created and saves the
--                      current settings into itself
--   trash button    -> deletes the folder
--   check button    -> loads the folder (applies all its settings)
-- ============================================================
local function folderFile(name)
	return CONFIG_FOLDER .. "/Folders/" .. (tostring(name):gsub("[^%w_%-]", "_")) .. ".json"
end

local function ensureFolderDirs()
	if typeof(isfolder) == "function" and typeof(makefolder) == "function" then
		if not isfolder(CONFIG_FOLDER) then
			makefolder(CONFIG_FOLDER)
		end
		if not isfolder(CONFIG_FOLDER .. "/Folders") then
			makefolder(CONFIG_FOLDER .. "/Folders")
		end
	end
end

function WindowMT:CreateFolder(o)
	if type(o) == "string" then
		o = { Name = o }
	end
	o = o or {}
	local name = tostring(o.Name or "Folder")
	if not self.Folders[name] then
		table.insert(self.FolderList, name)
	end
	self.Folders[name] = { Name = name, Flags = o.Flags, Prefix = o.Prefix, Preset = o.Preset, Callback = o.Callback }
	return self.Folders[name]
end

function WindowMT:_FolderKeys(folder)
	local keys = {}
	if type(folder.Flags) == "table" then
		for _, k in ipairs(folder.Flags) do
			if self.Flags[k] then
				table.insert(keys, k)
			end
		end
	else
		for k in pairs(self.Flags) do
			if not folder.Prefix or tostring(k):sub(1, #folder.Prefix) == folder.Prefix then
				table.insert(keys, k)
			end
		end
	end
	return keys
end

function WindowMT:SaveFolder(name, silent)
	local folder = self.Folders[name]
	if not folder then
		return false
	end
	if typeof(writefile) ~= "function" then
		if not silent then
			HE:Notify({ Title = "Folder", Content = "File system is not supported.", Type = "Warning" })
		end
		return false
	end
	local data = {}
	for _, k in ipairs(self:_FolderKeys(folder)) do
		local ok, v = pcall(self.Flags[k].Get)
		if ok then
			data[k] = encodeValue(v)
		end
	end
	local ok = pcall(function()
		ensureFolderDirs()
		writefile(folderFile(name), HttpService:JSONEncode(data))
	end)
	if not silent then
		HE:Notify({ Title = "Folder", Content = ok and ("Saved into: " .. name) or "Failed to save folder.", Type = ok and "Success" or "Error", Duration = 2.5 })
	end
	return ok
end

function WindowMT:LoadFolder(name)
	local folder = self.Folders[name]
	if not folder then
		return false
	end
	local data
	if typeof(isfile) == "function" and typeof(readfile) == "function" and isfile(folderFile(name)) then
		local ok, d = pcall(function()
			return HttpService:JSONDecode(readfile(folderFile(name)))
		end)
		if ok and type(d) == "table" then
			data = d
		end
	end
	if not data and type(folder.Preset) == "table" then
		data = {}
		for k, v in pairs(folder.Preset) do
			data[k] = encodeValue(v)
		end
	end
	if not data then
		HE:Notify({ Title = "Folder", Content = name .. " is empty.", Type = "Warning", Duration = 3 })
		return false
	end
	self._loading = true
	local count = 0
	for k, v in pairs(data) do
		local f = self.Flags[k]
		if f and pcall(f.Set, v, false) then
			count = count + 1
		end
	end
	self._loading = false
	self:_RefreshFavorites()
	self:_RefreshChips()
	if folder.Callback then
		safeCall(folder.Callback, name, count)
	end
	HE:Notify({ Title = "Folder", Content = name .. " loaded (" .. count .. " settings applied).", Type = "Success", Duration = 2.5 })
	self:_Changed()
	return true
end

function WindowMT:_SaveFolderList()
	pcall(function()
		if typeof(writefile) ~= "function" then
			return
		end
		ensureFolderDirs()
		writefile(CONFIG_FOLDER .. "/Folders/_list.json", HttpService:JSONEncode(self.FolderList))
	end)
end

function WindowMT:_LoadFolderList()
	pcall(function()
		local path = CONFIG_FOLDER .. "/Folders/_list.json"
		if typeof(isfile) ~= "function" or typeof(readfile) ~= "function" or not isfile(path) then
			return
		end
		local names = HttpService:JSONDecode(readfile(path))
		if type(names) ~= "table" then
			return
		end
		local keep = {}
		for _, n in ipairs(names) do
			keep[tostring(n)] = true
			if not self.Folders[tostring(n)] then
				self:CreateFolder({ Name = tostring(n) })
			end
		end
		for i = #self.FolderList, 1, -1 do
			local n = self.FolderList[i]
			if not keep[n] then
				table.remove(self.FolderList, i)
				self.Folders[n] = nil
			end
		end
	end)
end

function WindowMT:DeleteFolder(name)
	if not self.Folders[name] then
		return false
	end
	self.Folders[name] = nil
	local i = table.find(self.FolderList, name)
	if i then
		table.remove(self.FolderList, i)
	end
	pcall(function()
		if typeof(delfile) == "function" and typeof(isfile) == "function" and isfile(folderFile(name)) then
			delfile(folderFile(name))
		end
	end)
	self:_SaveFolderList()
	HE:Notify({ Title = "Folder", Content = name .. " deleted.", Duration = 2 })
	return true
end

