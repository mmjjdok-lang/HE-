local Guard = { Log = {}, Count = 0 }
HE.Guard = Guard

local Null
Null = setmetatable({}, {
	__index = function()
		return function()
			return Null
		end
	end,
	__call = function()
		return Null
	end,
})

function Guard.Report(where, err)
	Guard.Count = Guard.Count + 1
	table.insert(Guard.Log, { Where = where, Error = tostring(err), Time = os.clock() })
	if #Guard.Log > 50 then
		table.remove(Guard.Log, 1)
	end
	warn("[HE] " .. tostring(where) .. ": " .. tostring(err))
end

function HE.GetErrors()
	return Guard.Log
end

function Guard.Num(v, default, min, max)
	v = tonumber(v)
	if not v or v ~= v then
		v = default
	end
	if min and v < min then
		v = min
	end
	if max and v > max then
		v = max
	end
	return v
end

function Guard.Clean(name, o)
	if type(o) == "string" or type(o) == "number" then
		o = { Name = tostring(o) }
	end
	if type(o) ~= "table" then
		o = {}
	end
	local c = table.clone(o)
	if c.Name ~= nil and type(c.Name) ~= "string" then
		c.Name = tostring(c.Name)
	end
	if c.Callback ~= nil and type(c.Callback) ~= "function" then
		c.Callback = nil
	end
	if name == "CreateSlider" then
		local mn, mx = Guard.Num(c.Min, 0), Guard.Num(c.Max, 100)
		if mn > mx then
			mn, mx = mx, mn
		end
		if mn == mx then
			mx = mn + 1
		end
		c.Min, c.Max = mn, mx
		c.Increment = Guard.Num(c.Increment, 1)
		if c.Increment <= 0 then
			c.Increment = 1
		end
		c.Default = Guard.Num(c.Default, mn, mn, mx)
	elseif name == "CreateDropdown" or name == "CreatePlayerDropdown" then
		if type(c.Options) == "table" then
			local t = {}
			for _, v in ipairs(c.Options) do
				table.insert(t, tostring(v))
			end
			c.Options = t
		elseif type(c.Options) ~= "function" then
			c.Options = {}
		end
	end
	return c
end

function Guard.Wrap(name, fn, clean)
	return function(self, o, ...)
		local arg = o
		if clean then
			arg = Guard.Clean(name, o)
		end
		local res = table.pack(pcall(fn, self, arg, ...))
		if res[1] then
			return table.unpack(res, 2, res.n)
		end
		Guard.Report(name, res[2])
		return Null
	end
end

local function safeCall(fn, ...)
	if type(fn) ~= "function" then
		return
	end
	local ok, err = pcall(fn, ...)
	if not ok then
		Guard.Report("Callback", err)
	end
end

