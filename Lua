-- ============================================================
-- TABS
-- ============================================================
function TabMT:_Add(frame, name, kind, proxy)
	table.insert(self.Items, frame)
	local idx = #self.Items
	frame.LayoutOrder = idx
	frame.Parent = self.Columns[((idx - 1) % self.ColCount) + 1]
	if not proxy then
		table.insert(self.Window.Elements, { Name = name or "Element", Kind = kind, Tab = self, Frame = frame })
	end
end

function TabMT:_SetScrolling(b)
	self.Page.ScrollingEnabled = b
end

function TabMT:Clear()
	for _, f in ipairs(self.Items) do
		f:Destroy()
	end
	table.clear(self.Items)
end

function TabMT:Split(n)
	n = math.clamp(math.floor(tonumber(n) or 1), 1, 3)
	self.ColCount = n
	for i = 1, 3 do
		local col = self.Columns[i]
		col.Visible = i <= n
		col.Size = UDim2.new(1 / n, -(8 * (n - 1)) / n, 0, 0)
	end
	for idx, item in ipairs(self.Items) do
		item.LayoutOrder = idx
		item.Parent = self.Columns[((idx - 1) % n) + 1]
	end
end

function TabMT:Select()
	self.Window:SelectTab(self)
end

-- holder + 3 columns (shared by tabs and inner tabs)
makeColumns = function(tab, parent, order)
	local holder = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order, Parent = parent })
	list(holder, 8, Enum.FillDirection.Horizontal)
	tab.Holder = holder
	tab.Columns = {}
	for i = 1, 3 do
		local col = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(i == 1 and 1 or 0, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = i, Visible = i == 1, Parent = holder })
		list(col, 6)
		tab.Columns[i] = col
	end
end

-- grid of square image tiles (Image Button system)
function TabMT:_EnsureGrid()
	if self.Grid and self.Grid.Parent then
		return self.Grid
	end
	local g = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = self.GridOrder or 1, Parent = self.Root })
	New("UIGridLayout", { CellSize = UDim2.fromOffset(TILE, TILE), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = g })
	self.Grid = g
	if self.ActiveInner then
		g.Visible = false
	end
	return g
end

-- inner-tab strip: plain text chips, no frame, glued to the top of the tab
function TabMT:_EnsureBar()
	if self.Bar and self.Bar.Parent then
		return self.Bar
	end
	self.Chips = {}
	local bar = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 34), LayoutOrder = 1, Parent = self.Page })
	local line = New("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 1), BackgroundTransparency = 0.88, Parent = bar })
	bind(line, "BackgroundColor3", "Line")
	local strip = New("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -1), ScrollBarThickness = 0, ScrollingDirection = Enum.ScrollingDirection.X,
		AutomaticCanvasSize = Enum.AutomaticSize.X, CanvasSize = UDim2.new(), Parent = bar,
	})
	list(strip, 4, Enum.FillDirection.Horizontal)
	self.Bar, self.Strip = bar, strip
	self:_AddChip(nil, "Main", "home")
	return bar
end

function TabMT:_AddChip(inner, name, icon)
	local tab = self
	local chip = New("TextButton", { Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = #self.Chips + 1, Parent = self.Strip })
	pad(chip, 0, 0, 10, 10)
	local row = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, Parent = chip })
	list(row, 6, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	local ic = New("ImageLabel", { Size = UDim2.fromOffset(14, 14), LayoutOrder = 1, Parent = row })
	if icon and setIcon(ic, icon) then
		fitImage(ic)
	else
		ic.Visible = false
	end
	local lbl = New("TextLabel", { Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, Text = name, TextSize = 12, LayoutOrder = 2, Parent = row })
	local ul = New("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 0), Size = UDim2.new(0, 0, 0, 2), Parent = chip })
	bind(ul, "BackgroundColor3", "Accent")
	corner(ul, 1)
	local function style(animate)
		local active = (tab.ActiveInner == inner)
		local c = active and State.Theme.Text or State.Theme.SubText
		local sz = UDim2.new(active and 1 or 0, active and -12 or 0, 0, 2)
		if animate then
			tw(lbl, 0.2, { TextColor3 = c })
			tw(ic, 0.2, { ImageColor3 = c })
			tw(ul, 0.25, { Size = sz })
		else
			lbl.TextColor3, ic.ImageColor3, ul.Size = c, c, sz
		end
	end
	table.insert(self.Chips, { Inner = inner, Style = style })
	style(false)
	addRefresher(function()
		style(false)
	end)
	chip.Activated:Connect(function()
		playSound()
		tab:SelectInner(inner)
	end)
end

-- nil = back to the tab's own content
function TabMT:SelectInner(inner)
	if self.ActiveInner == inner then
		return
	end
	self.ActiveInner = inner
	local main = (inner == nil)
	self.Holder.Visible = main
	if self.Grid then
		self.Grid.Visible = main
	end
	for _, it in ipairs(self.InnerList) do
		it.Root.Visible = (it == inner)
	end
	for _, c in ipairs(self.Chips or {}) do
		c.Style(true)
	end
	if inner then
		playInnerAnim(inner.Root)
	end
	self.Page.CanvasPosition = Vector2.new(0, 0)
end

local function createTab(win, o, parentHolder, indent)
	o = o or {}
	local tab = setmetatable({ Window = win, Name = o.Name or "Tab", Items = {}, ColCount = 1, Kind = "Tab" }, TabMT)
	win.Counter = win.Counter + 10
	tab.Order = o.Order or win.Counter
	tab.EndOrder = tab.Order
	tab.ParentHolder = parentHolder
	local entry = New("TextButton", { Size = UDim2.new(1, 0, 0, 34), LayoutOrder = tab.Order, Parent = parentHolder })
	corner(entry, R_BTN)
	local ind = New("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 0), Size = UDim2.fromOffset(3, 0), Parent = entry })
	bind(ind, "BackgroundColor3", "Accent")
	corner(ind, 2)
	local ic = New("ImageLabel", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 12 + indent, 0.5, 0), Size = UDim2.fromOffset(16, 16), Parent = entry })
	local hasIcon = o.Icon and setIcon(ic, o.Icon) or false
	if hasIcon then
		fitImage(ic)
	end
	ic.Visible = hasIcon
	local lbl = New("TextLabel", {
		Position = UDim2.new(0, (hasIcon and 36 or 14) + indent, 0, 0), Size = UDim2.new(1, -(48 + indent), 1, 0),
		Text = tab.Name, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = entry,
	})
	if o.Tag then
		local pill, w = makeTag(entry, o.Tag)
		if pill then
			pill.AnchorPoint = Vector2.new(1, 0.5)
			pill.Position = UDim2.new(1, -6, 0.5, 0)
			lbl.Size = UDim2.new(1, -(54 + indent + w), 1, 0)
		end
	end
	local page = New("ScrollingFrame", { Size = UDim2.fromScale(1, 1), Visible = false, Parent = win.PageHolder })
	pad(page, 8, 12, 8, 8)
	list(page, 6)
	tab.Root, tab.GridOrder, tab.InnerList = page, 2, {}
	makeColumns(tab, page, 3)
	tab.Page, tab.Entry, tab.Indicator, tab.Label, tab.Icon = page, entry, ind, lbl, ic
	function tab:_Style(animate)
		local active = (win.Current == tab)
		local c = active and State.Theme.Text or State.Theme.SubText
		if animate then
			tw(lbl, 0.2, { TextColor3 = c })
			tw(ic, 0.2, { ImageColor3 = c })
			tw(ind, 0.2, { Size = UDim2.fromOffset(3, active and 16 or 0) })
			tw(entry, 0.2, { BackgroundTransparency = active and 0.9 or 1 })
		else
			lbl.TextColor3, ic.ImageColor3 = c, c
			ind.Size = UDim2.fromOffset(3, active and 16 or 0)
			entry.BackgroundTransparency = active and 0.9 or 1
		end
	end
	entry.BackgroundColor3 = WHITE
	tab:_Style(false)
	addRefresher(function()
		tab:_Style(false)
	end)
	entry.InputBegan:Connect(function(i)
		if isPress(i) then
			ripple(entry, i.Position.X, i.Position.Y)
		end
	end)
	entry.Activated:Connect(function()
		win:SelectTab(tab)
	end)
	win.TabByName[tab.Name] = tab
	if o.SectionName then
		tab:CreateSection(o.SectionName)
	end
	return tab
end

-- 5 tab animations: Slide, Rise, Drop, Zoom, Swing (random, automatic)
local PageScales = setmetatable({}, { __mode = "k" })

local function playTabAnim(page)
	local name = State.TabAnim
	if name == "Random" or not table.find(HE.TabAnimations, name) then
		name = HE.TabAnimations[math.random(#HE.TabAnimations)]
	end
	local sc = PageScales[page]
	if not (sc and sc.Parent == page) then
		sc = Instance.new("UIScale")
		sc.Parent = page
		PageScales[page] = sc
	end
	sc.Scale = 1
	page.Rotation = 0
	page.Position = UDim2.fromOffset(0, 0)
	if name == "Slide" then
		page.Position = UDim2.fromOffset(28, 0)
		tw(page, 0.32, { Position = UDim2.fromOffset(0, 0) })
	elseif name == "Rise" then
		page.Position = UDim2.fromOffset(0, 26)
		tw(page, 0.34, { Position = UDim2.fromOffset(0, 0) })
	elseif name == "Drop" then
		page.Position = UDim2.fromOffset(0, -26)
		tw(page, 0.34, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Bounce)
	elseif name == "Zoom" then
		sc.Scale = 0.9
		tw(sc, 0.36, { Scale = 1 }, Enum.EasingStyle.Back)
	elseif name == "Swing" then
		page.Rotation = 2.5
		page.Position = UDim2.fromOffset(18, 0)
		tw(page, 0.42, { Rotation = 0, Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Back)
	end
end

-- animation played when you ENTER an inner tab (fade + one of 5 motions)
playInnerAnim = function(root)
	local name = State.TabAnim
	if name == "Random" or not table.find(HE.TabAnimations, name) then
		name = HE.TabAnimations[math.random(#HE.TabAnimations)]
	end
	local p = root:FindFirstChildOfClass("UIPadding")
	if not p then
		return
	end
	local z = UDim.new(0, 0)
	p.PaddingLeft, p.PaddingTop, p.PaddingRight, p.PaddingBottom = z, z, z, z
	root.Rotation = 0
	root.GroupTransparency = 1
	tw(root, 0.3, { GroupTransparency = 0 })
	if name == "Slide" then
		p.PaddingLeft = UDim.new(0, 30)
		tw(p, 0.32, { PaddingLeft = z })
	elseif name == "Rise" then
		p.PaddingTop = UDim.new(0, 26)
		tw(p, 0.34, { PaddingTop = z })
	elseif name == "Drop" then
		p.PaddingTop = UDim.new(0, 26)
		tw(p, 0.42, { PaddingTop = z }, Enum.EasingStyle.Bounce)
	elseif name == "Zoom" then
		local u = UDim.new(0, 18)
		p.PaddingLeft, p.PaddingTop, p.PaddingRight = u, u, u
		tw(p, 0.36, { PaddingLeft = z, PaddingTop = z, PaddingRight = z }, Enum.EasingStyle.Back)
	elseif name == "Swing" then
		root.Rotation = 2.5
		p.PaddingLeft = UDim.new(0, 18)
		tw(root, 0.42, { Rotation = 0 }, Enum.EasingStyle.Back)
		tw(p, 0.42, { PaddingLeft = z }, Enum.EasingStyle.Back)
	end
end

function WindowMT:SelectTab(tab)
	if tab.ParentTab then -- inner tab: open its parent first, then the inner page
		self:SelectTab(tab.ParentTab)
		tab.ParentTab:SelectInner(tab)
		return
	end
	if self.SearchBox and self.SearchBox.Text ~= "" then
		self.SearchBox.Text = ""
	end
	if self.Current == tab then
		return
	end
	local old = self.Current
	self.Current = tab
	if old then
		old.Page.Visible = false
		old:_Style(true)
	end
	tab.Page.Visible = true
	playTabAnim(tab.Page)
	tab:_Style(true)
end

function WindowMT:CreateTab(o)
	local tab = createTab(self, o, self.TabHolder, 0)
	if o and o.SpacingAfter then
		self:CreateTabSpacing(tab.Name)
	end
	if not self.Current and tab ~= self.FavTab then
		self:SelectTab(tab)
	end
	return tab
end

-- Tab dropdown (nested tabs in the sidebar)
function WindowMT:CreateTabDropdown(o)
	o = o or {}
	local win = self
	self.Counter = self.Counter + 10
	local order = self.Counter
	local dd = { Name = o.Name or "Dropdown", Order = order, EndOrder = order + 1, ParentHolder = self.TabHolder, Tabs = {}, Open = false }
	local header = New("TextButton", { Size = UDim2.new(1, 0, 0, 34), LayoutOrder = order, Parent = self.TabHolder })
	corner(header, R_BTN)
	local ic = New("ImageLabel", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 12, 0.5, 0), Size = UDim2.fromOffset(16, 16), Parent = header })
	local hasIcon = o.Icon and setIcon(ic, o.Icon) or false
	ic.Visible = hasIcon
	local lbl = New("TextLabel", {
		Position = UDim2.new(0, hasIcon and 36 or 14, 0, 0), Size = UDim2.new(1, -58, 1, 0), Text = dd.Name,
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = header,
	})
	bind(lbl, "TextColor3", "SubText")
	bind(ic, "ImageColor3", "SubText")
	local arrow = New("TextLabel", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(14, 14), Text = ">", TextSize = 11, Font = FONT_BOLD, Parent = header })
	bind(arrow, "TextColor3", "SubText")
	local wrap = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), ClipsDescendants = true, LayoutOrder = order + 1, Parent = self.TabHolder })
	local inner = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = wrap })
	list(inner, 2)
	dd.ParentInner = inner
	local function innerHeight()
		return inner.AbsoluteSize.Y / math.max(win.UIScale.Scale, 0.01)
	end
	connect(inner:GetPropertyChangedSignal("AbsoluteSize"), function()
		if dd.Open then
			wrap.Size = UDim2.new(1, 0, 0, innerHeight())
		end
	end)
	local function setOpen(v)
		dd.Open = v
		tw(arrow, 0.25, { Rotation = v and 90 or 0 })
		tw(wrap, 0.3, { Size = UDim2.new(1, 0, 0, v and innerHeight() or 0) })
	end
	header.InputBegan:Connect(function(i)
		if isPress(i) then
			ripple(header, i.Position.X, i.Position.Y)
		end
	end)
	header.Activated:Connect(function()
		setOpen(not dd.Open)
	end)
	function dd:CreateTab(to)
		local t = createTab(win, to, inner, 14)
		table.insert(dd.Tabs, t)
		if not win.Current and t ~= win.FavTab then
			win:SelectTab(t)
		end
		return t
	end
	function dd:SetOpen(v)
		setOpen(v)
	end
	for _, to in ipairs(o.Tabs or {}) do
		dd:CreateTab(to)
	end
	if o.Open then
		task.defer(function()
			setOpen(true)
		end)
	end
	self.DropByName[dd.Name] = dd
	return dd
end

function WindowMT:CreateTabSpacing(afterName)
	local after = afterName and (self.TabByName[afterName] or self.DropByName[afterName])
	local order, parent
	if after then
		order, parent = after.EndOrder + 2, after.ParentHolder
	else
		self.Counter = self.Counter + 10
		order, parent = self.Counter, self.TabHolder
	end
	local sp = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 14), LayoutOrder = order, Parent = parent })
	local line = New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, -20, 0, 1), BackgroundTransparency = 0.85, Parent = sp })
	bind(line, "BackgroundColor3", "Line")
	return sp
end

function WindowMT:SplitButtons(tabName, count)
	local tab = self.TabByName[tabName]
	if not tab then
		warn("[HE] SplitButtons: tab not found: " .. tostring(tabName))
		return
	end
	tab:Split(count)
end

function WindowMT:GetTab(name)
	return self.TabByName[name]
end

function WindowMT:AddLabel(tabName, text)
	local tab = self.TabByName[tabName]
	if tab then
		return tab:CreateLabel(text)
	end
end

-- ---- Window-level helpers for the 3 new systems (tab name + options) ----
function WindowMT:_FindTab(name)
	if name == nil then
		return self.Current
	end
	if type(name) == "table" then
		return name
	end
	return self.TabByName[tostring(name)]
end

-- Window:CreateInnerTab({ Tab = "parent tab name", Name = "inner name", Icon = "icon" })
function WindowMT:CreateInnerTab(o)
	o = o or {}
	local parent = self:_FindTab(o.Tab or o.Parent)
	if not parent then
		warn("[HE] CreateInnerTab: tab not found: " .. tostring(o.Tab))
		return Null
	end
	return parent:CreateInnerTab({ Name = o.Name, Icon = o.Icon, Open = o.Open })
end

-- Window:CreateImageButton({ Tab = "tab name", Image = "rbxassetid://...", Callback = function() end })
function WindowMT:CreateImageButton(o)
	o = o or {}
	local tab = self:_FindTab(o.Tab)
	if not tab then
		warn("[HE] CreateImageButton: tab not found: " .. tostring(o.Tab))
		return Null
	end
	return tab:CreateImageButton(o)
end

-- Window:CreateEffects({ Tab = "tab name", Count = 30 })
function WindowMT:CreateEffects(o)
