	local function submit()
		local n = (box.Text:gsub("^%s+", ""):gsub("%s+$", ""))
		if n == "" then
			return
		end
		if win.Folders[n] then
			HE:Notify({ Title = "Folder", Content = n .. " already exists.", Type = "Warning", Duration = 2.5 })
			return
		end
		win:CreateFolder({ Name = n })
		win:SaveFolder(n, true)
		win:_SaveFolderList()
		HE:Notify({ Title = "Folder", Content = n .. " created with your current settings.", Type = "Success", Duration = 2.5 })
		box.Text = ""
		inputShown = false
		inRow.Visible = false
		build()
		layout()
	end

	add.Activated:Connect(function()
		playSound()
		inputShown = not inputShown
		inRow.Visible = inputShown
		if inputShown then
			box:CaptureFocus()
		end
		layout()
	end)
	okBtn.Activated:Connect(function()
		playSound()
		submit()
	end)
	box.FocusLost:Connect(function(enter)
		if enter then
			submit()
		end
	end)

	build()
	layout()
end

-- Guard: every public Window method is wrapped (errors are logged, never fatal)
for k, fn in pairs(WindowMT) do
	if type(fn) == "function" and k:sub(1, 1) ~= "_" then
		WindowMT[k] = Guard.Wrap("Window:" .. k, fn, false)
	end
end
