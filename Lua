local function resolveIcon(icon)
	if icon == nil or icon == "" then
		return nil
	end
	if type(icon) == "number" then
		return "rbxassetid://" .. tostring(icon)
	end
	if type(icon) == "string" then
		if icon:find("rbxassetid://", 1, true) or icon:find("rbxthumb://", 1, true) or icon:find("http", 1, true) == 1 then
			return icon
		end
		if icon:match("^%d+$") then
			return "rbxassetid://" .. icon
		end
		local icons = ensureIcons()
		if icons then
			for _, fname in ipairs({ "GetIcon", "Icon" }) do
				local fn = icons[fname]
				if type(fn) == "function" then
					local ok, res = pcall(fn, icon)
					if ok and res then
						return res
					end
				end
			end
		end
	end
	return nil
end

function applyIconNow(label, icon)
	local r = resolveIcon(icon)
	if type(r) == "table" then
		local meta = type(r[2]) == "table" and r[2] or nil
		local img = r.Image or r.image or r[1]
		local pos = r.ImageRectPosition or r.ImageRectOffset or (meta and (meta.ImageRectPosition or meta.ImageRectOffset))
		local sz = r.ImageRectSize or (meta and meta.ImageRectSize)
		if type(img) ~= "string" or img == "" then
			return false
		end
		label.Image = img
		if typeof(pos) == "Vector2" then
			label.ImageRectOffset = pos
		end
		if typeof(sz) == "Vector2" then
			label.ImageRectSize = sz
		end
		return true
	elseif type(r) == "string" then
		label.Image = r
		return true
	end
	return false
end

local function setIcon(label, icon)
	if type(icon) == "string" and icon ~= "" and not Lib.IconsDone
		and not icon:find("rbxassetid://", 1, true) and not icon:find("rbxthumb://", 1, true)
		and icon:find("http", 1, true) ~= 1 and not icon:match("^%d+$") then
		Lib.PendingIcons = Lib.PendingIcons or {}
		table.insert(Lib.PendingIcons, { label, icon })
		return true
	end
	return applyIconNow(label, icon)
end

