function Elements:CreateInnerTab(o)
	o = o or {}
	local win = self.Window
	local parent = self.ParentTab or self
	if parent.Kind ~= "Tab" or not parent.Root then
		error("CreateInnerTab must be used on a tab")
	end
	local inner = setmetatable({
		Window = win, Name = o.Name or "Inner", Items = {}, ColCount = 1, Kind = "Tab",
		ParentTab = parent, Page = parent.Page, GridOrder = 1,
	}, TabMT)
	parent:_EnsureBar()
	local root = New("CanvasGroup", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 10 + #parent.InnerList, Visible = false, Parent = parent.Page,
	})
	New("UIPadding", { Parent = root })
	list(root, 6)
	inner.Root = root
	makeColumns(inner, root, 2)
	table.insert(parent.InnerList, inner)
	parent:_AddChip(inner, inner.Name, o.Icon)
	if not win.TabByName[inner.Name] then
		win.TabByName[inner.Name] = inner
	end
	if o.Open then
		parent:SelectInner(inner)
	end
	return inner
end

