-- WINDOW METHODS
-- ============================================================
function WindowMT:_Flag(key, getter, setter)
	if not key then
		return
	end
	self.Flags[key] = { Get = getter, Set = setter }
end

function WindowMT:_RegisterBind(info)
	local id = info.Kind .. ":" .. info.Name
	local n = 1
	local base = id
	local function exists(x)
		for _, b in ipairs(self.Binds) do
			if b.Id == x then
				return true
			end
		end
		return false
	end
	while exists(id) do
		n = n + 1
		id = base .. " (" .. n .. ")"
	end
	local key = toKey(info.Keybind)
	local e = { Id = id, Name = info.Name, Kind = info.Kind, Key = key, Enabled = key ~= nil, Fire = info.Fire }
	table.insert(self.Binds, e)
	if self.KBRefresh then
		self.KBRefresh()
	end
	return e
end

function WindowMT:_RefreshFavorites()
	local tab = self.FavTab
	if not tab then
		return
	end
	tab:Clear()
	local count = 0
	for _, e in ipairs(self.Binds) do
		if self.FavSet[e.Id] and e.Proxy then
			count = count + 1
			e.Proxy(tab)
		end
	end
	if count == 0 then
		tab:CreateLabel({ Text = "No favorites yet. Right-click (PC) or long-press (mobile) a Button or Toggle to pin it here.", _Proxy = true })
	end
end

function WindowMT:_RefreshChips()
	for _, e in ipairs(self.Binds) do
		for _, upd in ipairs(e.Chips or {}) do
			pcall(upd)
		end
	end
	if self.KBRefresh then
		self.KBRefresh()
	end
end

function WindowMT:_Reveal(e)
	if not (e.Tab and e.Row and e.Row.Parent) then
		return
	end
	if not self.Visible or self.Compact then
		return
	end
	self:SelectTab(e.Tab)
	task.spawn(function()
		task.wait(0.12)
		if not (e.Row and e.Row.Parent) then
			return
		end
		local pg = e.Tab.Page
		local y = e.Row.AbsolutePosition.Y - pg.AbsolutePosition.Y + pg.CanvasPosition.Y - 8
		pg.CanvasPosition = Vector2.new(0, math.max(y, 0))
		tw(e.Row, 0.18, { BackgroundColor3 = State.Accent:Lerp(BLACK, 0.55) })
		task.wait(0.32)
		if e.Row and e.Row.Parent then
			tw(e.Row, 0.4, { BackgroundColor3 = State.Theme.Element })
		end
	end)
end

function WindowMT:_PressEntry(e, source)
	if source == "panel" and self.SyncView then
		self:_Reveal(e)
	end
	task.spawn(safeCall, e.Fire)
end

function WindowMT:_BeginRebind(e)
	if self.Rebinding == e then
		self.Rebinding = nil
		self:_RefreshChips()
		return
	end
	self.Rebinding = e
	self:_RefreshChips()
	HE:Notify({ Title = "Shortcut", Content = "Press a keyboard key for \"" .. e.Name .. "\"  (Esc cancel, Backspace clear).", Duration = 3 })
end

function WindowMT:_Changed()
	if self._loading or not self.AutoSave then
		return
	end
	self._saveToken = (self._saveToken or 0) + 1
	local t = self._saveToken
	task.delay(1, function()
		if t == self._saveToken and self.Gui and self.Gui.Parent then
			self:SaveConfig(nil, true)
		end
	end)
end

local function encodeValue(v)
	if typeof(v) == "Color3" then
		return { __color = { v.R, v.G, v.B } }
	end
	return v
end

local function configPath(name)
	return CONFIG_FOLDER .. "/" .. name .. ".json"
end

function WindowMT:SaveConfig(name, silent)
	name = name or self.ConfigName
	if typeof(writefile) ~= "function" then
		if not silent then
			HE:Notify({ Title = "Config", Content = "File system is not supported.", Type = "Warning" })
		end
		return false
	end
	local data = { Flags = {}, Binds = {}, Favs = {} }
	for k, f in pairs(self.Flags) do
		local ok, v = pcall(f.Get)
		if ok then
			data.Flags[k] = encodeValue(v)
		end
	end
	for _, b in ipairs(self.Binds) do
		data.Binds[b.Id] = { Key = b.Key and b.Key.Name or "None", Enabled = b.Enabled }
	end
	for id in pairs(self.FavSet) do
		table.insert(data.Favs, id)
	end
	local ok = pcall(function()
		if typeof(isfolder) == "function" and not isfolder(CONFIG_FOLDER) then
			makefolder(CONFIG_FOLDER)
		end
		writefile(configPath(name), HttpService:JSONEncode(data))
	end)
	if not silent then
		HE:Notify({ Title = "Config", Content = ok and ("Saved: " .. name) or "Failed to save config.", Type = ok and "Success" or "Error", Duration = 2.5 })
	end
	return ok
end

function WindowMT:LoadConfig(name, silent)
	name = name or self.ConfigName
	if typeof(readfile) ~= "function" or typeof(isfile) ~= "function" or not isfile(configPath(name)) then
		if not silent then
			HE:Notify({ Title = "Config", Content = "No saved config found.", Type = "Warning", Duration = 2.5 })
		end
		return false
	end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(readfile(configPath(name)))
	end)
	if not ok or type(data) ~= "table" then
		return false
	end
	self._loading = true
	for k, v in pairs(data.Flags or {}) do
		local f = self.Flags[k]
		if f then
			pcall(f.Set, v, false)
		end
	end
	for id, b in pairs(data.Binds or {}) do
		for _, e in ipairs(self.Binds) do
			if e.Id == id then
				e.Key = toKey(b.Key)
				e.Enabled = b.Enabled == true and e.Key ~= nil
			end
		end
	end
	table.clear(self.FavSet)
	for _, id in ipairs(data.Favs or {}) do
		self.FavSet[id] = true
	end
	for _, e in ipairs(self.Binds) do
		e.Pinned = self.FavSet[e.Id] == true
	end
	self._loading = false
	self:_RefreshFavorites()
	self:_RefreshChips()
	if not silent then
		HE:Notify({ Title = "Config", Content = "Loaded: " .. name, Type = "Success", Duration = 2.5 })
	end
	return true
end

function WindowMT:Notify(o)
	HE:Notify(o)
end

function WindowMT:Copy(text, label)
	return HE:Copy(text, label)
end

function WindowMT:SetTheme(name)
	local t = HE.Themes[name]
	if t then
		State.Theme, State.ThemeName = t, name
		applyTheme(true)
	end
end

function WindowMT:SetAccent(c)
	local col = HE.GetColor(c)
	if col then
		State.Accent = col
		if type(c) == "string" then
			State.AccentName = c
		end
		applyTheme(true)
	end
end

function WindowMT:SetScale(s)
	State.UserScale = math.clamp(tonumber(s) or 1, 0.5, 1.5)
	tw(self.UIScale, 0.25, { Scale = self.AutoScale * State.UserScale })
end

function WindowMT:SetTransparency(t)
	State.Transparency = math.clamp(tonumber(t) or 0, 0, 0.8)
	if self.Visible then
		tw(self.Main, 0.25, { GroupTransparency = State.Transparency })
	end
end

-- Appearance settings. The 10 animations run automatically (random), so
-- there are no animation dropdowns any more.
function WindowMT:CreateUISettings(tab)
	tab:CreateSection("Appearance")
	tab:CreateDropdown({ Name = "Theme Preset", Options = HE.ThemeNames, Default = State.ThemeName, Flag = "UI_Theme", Callback = function(v) if v then self:SetTheme(v) end end })
	tab:CreateDropdown({ Name = "Accent Color", Description = "Choose from 30 named colors.", Options = HE.ColorNames, Default = State.AccentName, Search = true, Flag = "UI_Accent", Callback = function(v) if v then self:SetAccent(v) end end })
	tab:CreateSlider({ Name = "UI Scale", Min = 0.6, Max = 1.4, Default = State.UserScale, Increment = 0.05, Flag = "UI_Scale", Callback = function(v) self:SetScale(v) end })
	tab:CreateSlider({ Name = "UI Transparency", Min = 0, Max = 0.7, Default = State.Transparency, Increment = 0.05, Flag = "UI_Transparency", Callback = function(v) self:SetTransparency(v) end })
end

function WindowMT:SetVisible(v)
	if v == self.Visible then
		return
	end
	self.Visible = v
	local target = self.AutoScale * State.UserScale
	if v then
		self.Main.Visible = true
		self.UIScale.Scale = target * 0.92
		tw(self.UIScale, 0.3, { Scale = target }, Enum.EasingStyle.Back)
		tw(self.Main, 0.25, { GroupTransparency = State.Transparency })
	else
		tw(self.Main, 0.2, { GroupTransparency = 1 })
		tw(self.UIScale, 0.2, { Scale = target * 0.92 })
		task.delay(0.21, function()
			if not self.Visible and self.Main.Parent then
				self.Main.Visible = false
			end
		end)
	end
end

function WindowMT:Toggle()
	self:SetVisible(not self.Visible)
end

function WindowMT:Destroy()
	destroyAll()
end

