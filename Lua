local function uiScaleOf(inst)
	local p = inst
	while p do
		local s = p:FindFirstChildOfClass("UIScale")
		if s then
			return s.Scale
		end
		p = p.Parent
	end
	return 1
end

local RippleLayers = setmetatable({}, { __mode = "k" })

local function getRippleLayer(parent)
	local layer = RippleLayers[parent]
	if layer and layer.Parent == parent then
		return layer
	end
	layer = New("CanvasGroup", {
		BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 49, Active = false, Parent = parent,
	})
	local c = parent:FindFirstChildOfClass("UICorner")
	corner(layer, c and c.CornerRadius.Offset or 0)
	RippleLayers[parent] = layer
	return layer
end

local function ripple(parent, x, y, color)
	if not parent or not parent.Parent then
		return
	end
	if parent:IsA("GuiObject") and parent.AutomaticSize ~= Enum.AutomaticSize.None then
		tw(parent, 0.08, { BackgroundColor3 = State.Theme.Element:Lerp(WHITE, 0.14) })
		task.delay(0.1, function()
			if parent.Parent then
				tw(parent, 0.3, { BackgroundColor3 = State.Theme.Element })
			end
		end)
		return
	end
	local layer = getRippleLayer(parent)
	local sc = uiScaleOf(layer)
	local ap = layer.AbsolutePosition
	local size = math.max(layer.AbsoluteSize.X, layer.AbsoluteSize.Y) * 2 / sc
	local r = New("Frame", {
		BackgroundColor3 = color or WHITE, BackgroundTransparency = 0.8,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset((x - ap.X) / sc, (y - ap.Y) / sc),
		Size = UDim2.fromOffset(0, 0), Parent = layer,
	})
	corner(r, 999)
	tw(r, 0.6, { Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1 })
	task.delay(0.65, function()
		r:Destroy()
	end)
end

local function isPress(i)
	return i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1
end

local function clampPos(udim, target)
	local vp = (Lib.Gui and Lib.Gui.AbsoluteSize) or Vector2.new(1280, 720)
	local size = target and target.AbsoluteSize or Vector2.new(0, 0)
	local ap = target and target.AnchorPoint or Vector2.new(0.5, 0.5)
	local minX, maxX = ap.X * size.X, vp.X - (1 - ap.X) * size.X
	local minY, maxY = ap.Y * size.Y, vp.Y - (1 - ap.Y) * size.Y
	if maxX < minX then
		minX = (minX + maxX) / 2
		maxX = minX
	end
	if maxY < minY then
		minY = (minY + maxY) / 2
		maxY = minY
	end
	local x = math.clamp(udim.X.Scale * vp.X + udim.X.Offset, minX, maxX)
	local y = math.clamp(udim.Y.Scale * vp.Y + udim.Y.Offset, minY, maxY)
	return UDim2.fromOffset(x, y)
end

local function keepInside(target)
	if not (target and target.Parent and Lib.Gui) then
		return
	end
	local size, ap = target.AbsoluteSize, target.AnchorPoint
	if size.X <= 0 or size.Y <= 0 then
		return
	end
	local p = target.AbsolutePosition + Vector2.new(size.X * ap.X, size.Y * ap.Y)
	local want = clampPos(UDim2.fromOffset(p.X, p.Y), target)
	if math.abs(want.X.Offset - p.X) > 1 or math.abs(want.Y.Offset - p.Y) > 1 then
		target.Position = want
	end
end

local function makeDraggable(handle, target, opts)
	opts = opts or {}
	local active, startPos, startUDim, moved, lastPos, lastT, vel, goal
	connect(handle.InputBegan, function(input)
		if active then
			return
		end
		if not isPress(input) then
			return
		end
		if opts.Enabled and not opts.Enabled() then
			return
		end
		active = input
		startPos = input.Position
		startUDim = target.Position
		goal = startUDim
		moved = false
		lastPos = input.Position
		lastT = os.clock()
		vel = Vector2.new(0, 0)
		ripple(handle, input.Position.X, input.Position.Y)
		playSound()
	end)
	connect(UserInputService.InputChanged, function(input)
		if not active then
			return
		end
		if active.UserInputType == Enum.UserInputType.Touch then
			if input ~= active then
				return
			end
		elseif input.UserInputType ~= Enum.UserInputType.MouseMovement then
			return
		end
		local p = input.Position
		local dx, dy = p.X - startPos.X, p.Y - startPos.Y
		if not moved and math.sqrt(dx * dx + dy * dy) < 6 then
			return
		end
		moved = true
		local now = os.clock()
		local dt = math.max(now - lastT, 1 / 240)
		vel = Vector2.new((p.X - lastPos.X) / dt, (p.Y - lastPos.Y) / dt)
		lastPos, lastT = p, now
		goal = clampPos(UDim2.new(startUDim.X.Scale, startUDim.X.Offset + dx, startUDim.Y.Scale, startUDim.Y.Offset + dy), target)
		tw(target, 0.22, { Position = goal }, Enum.EasingStyle.Sine)
	end)
	connect(UserInputService.InputEnded, function(input)
		if not active then
			return
		end
		local same = (input == active)
			or (active.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1)
		if not same then
			return
		end
		local wasMoved = moved
		active = nil
		if wasMoved then
			if os.clock() - lastT < 0.1 then
				local ix = math.clamp(vel.X * 0.12, -140, 140)
				local iy = math.clamp(vel.Y * 0.12, -140, 140)
				tw(target, 0.5, { Position = clampPos(UDim2.new(goal.X.Scale, goal.X.Offset + ix, goal.Y.Scale, goal.Y.Offset + iy), target) })
			end
		elseif opts.OnClick then
			safeCall(opts.OnClick)
		end
	end)
end

local function trackPointer(gui, onMove, onBegin, onEnd, bag)
	local active
	connect(gui.InputBegan, function(input)
		if active then
			return
		end
		if isPress(input) then
			active = input
			if onBegin then
				onBegin()
			end
			onMove(input.Position)
		end
	end, bag)
	connect(UserInputService.InputChanged, function(input)
		if not active then
			return
		end
		if active.UserInputType == Enum.UserInputType.Touch then
			if input ~= active then
				return
			end
		elseif input.UserInputType ~= Enum.UserInputType.MouseMovement then
			return
		end
		onMove(input.Position)
	end, bag)
	connect(UserInputService.InputEnded, function(input)
		if active and (input == active or (active.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1)) then
			active = nil
			if onEnd then
				onEnd()
			end
		end
	end, bag)
end

