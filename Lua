local function addRefresher(fn)
	table.insert(Refreshers, fn)
end

local function applyTheme(animate)
	local i = 1
	while i <= #Bound do
		local b = Bound[i]
		if b[1] and b[1].Parent then
			if animate then
				tw(b[1], 0.3, { [b[2]] = themeColor(b[3]) })
			else
				b[1][b[2]] = themeColor(b[3])
			end
			i = i + 1
		else
			table.remove(Bound, i)
		end
	end
	for _, fn in ipairs(Refreshers) do
		pcall(fn)
	end
end

