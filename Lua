local Loader = { Jobs = 0, Done = 0, Cache = {} }
HE.Loader = Loader

function Loader.Spawn(fn, ...)
	Loader.Jobs = Loader.Jobs + 1
	return task.spawn(function(...)
		local ok, err = pcall(fn, ...)
		Loader.Done = Loader.Done + 1
		if not ok then
			Guard.Report("Loader", err)
		end
	end, ...)
end

function Loader.Wait(timeout)
	local t0 = os.clock()
	while Loader.Done < Loader.Jobs and os.clock() - t0 < (timeout or 2) do
		task.wait(0.03)
	end
end

function Loader.Preload(assets)
	local ContentProvider = game:GetService("ContentProvider")
	local chunk = {}
	local function flush()
		if #chunk == 0 then
			return
		end
		local c = chunk
		chunk = {}
		Loader.Spawn(function()
			pcall(function()
				ContentProvider:PreloadAsync(c)
			end)
		end)
	end
	for _, a in ipairs(assets or {}) do
		if type(a) == "string" and a ~= "" and not Loader.Cache[a] then
			Loader.Cache[a] = true
			table.insert(chunk, a)
			if #chunk >= 8 then
				flush()
			end
		end
	end
	flush()
end

