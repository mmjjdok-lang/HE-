	stroke(row, WHITE, 1, 0.94)
	local lens = New("ImageLabel", {
		Image = SEARCH_ICON, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 14, 0.5, 0),
		Size = UDim2.fromOffset(16, 16), ImageTransparency = 0.2, Parent = row,
	})
	bind(lens, "ImageColor3", "SubText")
	local holder = New("Frame", {
		BackgroundTransparency = 1, Position = UDim2.new(0, 40, 0, 0),
		Size = UDim2.new(1, -((rightReserve or 0) + 54), 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = row,
	})
	pad(holder, 11, 11, 0, 0)
	list(holder, 3)
	local nameLbl = New("TextLabel", {
		Size = UDim2.new(1, -(nameReserve or 0), 0, 16), Text = o.Name or "Element", TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd, LayoutOrder = 1, Parent = holder,
	})
	bind(nameLbl, "TextColor3", "Text")
	if o.Tag then
		local w = measure(nameLbl.Text, 13, FONT, 1000).X
		local pill = makeTag(nameLbl, o.Tag)
		if pill then
			pill.AnchorPoint = Vector2.new(0, 0.5)
			pill.Position = UDim2.new(0, w + 8, 0.5, 0)
		end
	end
	local desc
	if o.Description and o.Description ~= "" then
		desc = New("TextLabel", {
			Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Text = o.Description, TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextSize = 11, Font = FONT_REG,
			LayoutOrder = 2, Parent = holder,
		})
		bind(desc, "TextColor3", "SubText")
	end
	row:SetAttribute("Tip", o.Tooltip)
	return row, holder, nameLbl, desc
end

local RowScales = setmetatable({}, { __mode = "k" })

local function rowScale(row)
	local sc = RowScales[row]
	if sc and sc.Parent == row then
		return sc
	end
	sc = Instance.new("UIScale")
	sc.Parent = row
	RowScales[row] = sc
	return sc
end

local function clickFx(row, x, y)
	if not (row and row.Parent) then
		return
	end
	local name = State.ClickAnim
	if name == "Random" or not table.find(HE.ClickAnimations, name) then
		name = HE.ClickAnimations[math.random(#HE.ClickAnimations)]
	end
	if name == "Ripple" then
		ripple(row, x, y)
	elseif name == "Squash" or name == "Pop" then
		local sc = rowScale(row)
		tw(sc, 0.07, { Scale = (name == "Squash") and 0.955 or 1.035 }, Enum.EasingStyle.Quad)
		task.delay(0.08, function()
			if sc.Parent then
				tw(sc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
			end
		end)
	elseif name == "Glow" then
		local st = row:FindFirstChildOfClass("UIStroke")
		if st then
			st.Color = State.Accent
			st.Thickness = 2
			st.Transparency = 0.1
			tw(st, 0.55, { Transparency = 0.94, Thickness = 1 })
			task.delay(0.57, function()
				if st.Parent then
					st.Color = WHITE
				end
			end)
		end
	elseif name == "Wobble" then
		task.spawn(function()
			for _, r in ipairs({ 1.6, -1.4, 0.8, 0 }) do
				if not row.Parent then
					return
				end
				tw(row, 0.07, { Rotation = r }, Enum.EasingStyle.Sine)
				task.wait(0.07)
			end
		end)
	end
end

local function hoverFx(hit, row)
	connect(hit.MouseEnter, function()
		tw(row, 0.15, { BackgroundColor3 = State.Theme.ElementHover })
	end)
	connect(hit.MouseLeave, function()
		tw(row, 0.15, { BackgroundColor3 = State.Theme.Element })
	end)
	attachTooltip(hit, row:GetAttribute("Tip"))
end

local function rippleOn(hit, row)
	connect(hit.InputBegan, function(i)
		if isPress(i) then
			clickFx(row, i.Position.X, i.Position.Y)
		end
	end)
end

local function pulse(row)
	if row and row.Parent and row.AbsoluteSize.X > 0 then
		local p = row.AbsolutePosition + row.AbsoluteSize / 2
		ripple(row, p.X, p.Y, State.Accent)
	end
end

-- Key helpers -------------------------------------------------------
local DIGIT_TO_NAME = { ["0"] = "Zero", ["1"] = "One", ["2"] = "Two", ["3"] = "Three", ["4"] = "Four", ["5"] = "Five", ["6"] = "Six", ["7"] = "Seven", ["8"] = "Eight", ["9"] = "Nine" }
local NAME_TO_DIGIT = {}
for d, n in pairs(DIGIT_TO_NAME) do
	NAME_TO_DIGIT[n] = d
end

local function toKey(k)
	if typeof(k) == "EnumItem" then
		return k
	end
	if type(k) == "string" then
		k = k:gsub("%s", "")
		if k == "" or k:lower() == "none" then
			return nil
		end
		if DIGIT_TO_NAME[k] then
			k = DIGIT_TO_NAME[k]
		end
		local lk = k:lower()
		for _, item in ipairs(Enum.KeyCode:GetEnumItems()) do
			if item.Name:lower() == lk then
				return item
			end
		end
	end
	return nil
end

local KB_PRESENT = UserInputService.KeyboardEnabled
local function chipReserve()
	return KB_PRESENT and 56 or 0
end

local function shortKeyName(k)
	local n = k.Name
	if NAME_TO_DIGIT[n] then
		return NAME_TO_DIGIT[n]
	end
	n = n:gsub("^Left", "L"):gsub("^Right", "R"):gsub("Control", "Ctrl"):gsub("Return", "Enter")
	n = n:gsub("^Keypad", "Kp"):gsub("Backquote", "`"):gsub("Equals", "="):gsub("Minus", "-")
	return n
end

local function makeKeyChip(win, row, entry, rightOffset)
	if not KB_PRESENT then
		return
	end
	local chip = New("TextButton", {
		BackgroundTransparency = 0, BackgroundColor3 = State.Theme.Panel, AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -rightOffset, 0.5, 0), Size = UDim2.fromOffset(48, 24), Font = FONT_BOLD, TextSize = 10,
		TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 6, Parent = row,
	})
	bind(chip, "BackgroundColor3", "Panel")
	corner(chip, R_SMALL)
	stroke(chip, WHITE, 1, 0.86)
	local function update()
		if not chip.Parent then
			return
		end
		if win.Rebinding == entry then
			chip.Text, chip.TextColor3 = "...", State.Accent
		elseif entry.Key then
			chip.Text = shortKeyName(entry.Key)
			chip.TextColor3 = entry.Enabled and State.Theme.Text or State.Theme.SubText
		else
			chip.Text, chip.TextColor3 = "+", State.Theme.SubText
		end
	end
	entry.Chips = entry.Chips or {}
	table.insert(entry.Chips, update)
	chip.Activated:Connect(function()
		playSound()
		win:_BeginRebind(entry)
	end)
	attachTooltip(chip, "Click, then press a keyboard key to set the shortcut")
	update()
end

local function attachFavorite(win, hit, entry)
	local st = { suppress = false }
	local function toggleFav()
		if win.FavSet[entry.Id] then
			win.FavSet[entry.Id] = nil
			entry.Pinned = false
			HE:Notify({ Title = "Favorites", Content = entry.Name .. " removed.", Duration = 2 })
		else
			win.FavSet[entry.Id] = true
			entry.Pinned = true
			HE:Notify({ Title = "Favorites", Content = entry.Name .. " pinned.", Type = "Success", Duration = 2 })
		end
		win:_RefreshFavorites()
		win:_Changed()
	end
	entry.ToggleFav = toggleFav
	connect(hit.InputBegan, function(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton2 then
			toggleFav()
		elseif t == Enum.UserInputType.Touch or t == Enum.UserInputType.MouseButton1 then
			st.suppress = false
			if t == Enum.UserInputType.Touch then
				local start = input.Position
				task.delay(0.6, function()
					if input.UserInputState ~= Enum.UserInputState.End and (input.Position - start).Magnitude < 8 then
						st.suppress = true
						toggleFav()
					end
				end)
			end
		end
	end)
	return st
end

