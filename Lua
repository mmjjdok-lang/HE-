local function New(class, props)
	-- The search magnifier asset does not always load: it becomes an emoji.
	if class == "ImageLabel" and props and props.Image == SEARCH_ICON then
		local p = {}
		for k, v in pairs(props) do
			if k == "ImageColor3" then
				p.TextColor3 = v
			elseif k == "ImageTransparency" then
				p.TextTransparency = v
			elseif k ~= "Image" then
				p[k] = v
			end
		end
		p.Text, p.TextScaled = "🔍", true
		class, props = "TextLabel", p
	end
	local inst = Instance.new(class)
	inst.Name = rn()
	for k, v in pairs(DEFAULTS[class] or {}) do
		inst[k] = v
	end
	local parent
	for k, v in pairs(props or {}) do
		if k == "Parent" then
			parent = v
		else
			inst[k] = v
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

