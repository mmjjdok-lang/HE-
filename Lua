local FX = {}

function FX.newCtx()
	return { orig = {}, extra = {}, conns = {} }
end

function FX.put(ctx, inst, prop, val)
	local rec = ctx.orig[inst]
	if not rec then
		rec = {}
		ctx.orig[inst] = rec
	end
	if rec[prop] == nil then
		local ok, cur = pcall(function()
			return inst[prop]
		end)
		if not ok then
			return
		end
		rec[prop] = { cur }
	end
	pcall(function()
		inst[prop] = val
	end)
end

function FX.undo(ctx)
	for _, c in ipairs(ctx.conns) do
		pcall(function()
			c:Disconnect()
		end)
	end
	if ctx.scaleModel and ctx.scale0 then
		pcall(function()
			ctx.scaleModel:ScaleTo(ctx.scale0)
		end)
	end
	for inst, rec in pairs(ctx.orig) do
		if inst.Parent then
			for prop, box in pairs(rec) do
				pcall(function()
					inst[prop] = box[1]
				end)
			end
		end
	end
	for _, e in ipairs(ctx.extra) do
		pcall(function()
			e:Destroy()
		end)
	end
end

function FX.parts(char, acc)
	local t = {}
	for _, p in ipairs(char:GetDescendants()) do
		if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" and (acc or p.Parent == char) then
			table.insert(t, p)
		end
	end
	return t
end

function FX.paint(ctx, char, color, mat, tr, acc)
	for _, p in ipairs(FX.parts(char, acc)) do
		if color then
			FX.put(ctx, p, "Color", color)
		end
		if mat then
			FX.put(ctx, p, "Material", mat)
		end
		if tr then
			FX.put(ctx, p, "Transparency", tr)
		end
	end
	if tr then
		local hd = char:FindFirstChild("Head")
		if hd then
			for _, d in ipairs(hd:GetChildren()) do
				if d:IsA("Decal") then
					FX.put(ctx, d, "Transparency", tr)
				end
			end
		end
	end
end

function FX.nscale(ctx, hum, name, val)
	local nv = hum and hum:FindFirstChild(name)
	if nv and nv:IsA("NumberValue") then
		FX.put(ctx, nv, "Value", val)
		return true
	end
	return false
end

function FX.uni(ctx, char, k)
	pcall(function()
		if ctx.scale0 == nil then
			ctx.scale0 = char:GetScale()
			ctx.scaleModel = char
		end
		char:ScaleTo(ctx.scale0 * k)
	end)
end

function FX.head(ctx, char, hum, preview, k)
	if preview or not FX.nscale(ctx, hum, "HeadScale", k) then
		local hd = char:FindFirstChild("Head")
		if hd then
			FX.put(ctx, hd, "Size", hd.Size * k)
		end
	end
end

-- Builds the effect list. Count = how many effects the dropdown has.
function FX.defs(count)
	local P, M = FX.put, Enum.Material
	local function skin(name, color, mat, tr, acc)
		return { name, function(c, ch)
			FX.paint(c, ch, color, mat, tr, acc)
		end }
	end
	local pool = {
		{ "Headless", function(c, ch)
			local hd = ch:FindFirstChild("Head")
			if hd then
				P(c, hd, "Transparency", 1)
				for _, d in ipairs(hd:GetChildren()) do
					if d:IsA("Decal") then
						P(c, d, "Transparency", 1)
					end
				end
			end
		end },
		{ "Korblox", function(c, ch)
			for _, n in ipairs({ "RightUpperLeg", "RightLowerLeg", "RightFoot", "Right Leg" }) do
				local p = ch:FindFirstChild(n)
				if p then
					P(c, p, "Color", rgb(28, 28, 34))
					P(c, p, "Material", M.Metal)
				end
			end
		end },
		{ "Rthro", function(c, ch, h)
			if not FX.nscale(c, h, "BodyTypeScale", 1) then
				FX.uni(c, ch, 1.08)
			end
			FX.nscale(c, h, "BodyProportionScale", 0)
			FX.nscale(c, h, "BodyWidthScale", 1.05)
		end },
		{ "Chibi", function(c, ch, h, pv)
			if pv or not (FX.nscale(c, h, "HeadScale", 1.9) and FX.nscale(c, h, "BodyHeightScale", 0.6)) then
				FX.uni(c, ch, 0.6)
			end
			FX.nscale(c, h, "BodyWidthScale", 0.8)
		end },
		{ "Giant", function(c, ch) FX.uni(c, ch, 1.7) end },
		{ "Mini", function(c, ch) FX.uni(c, ch, 0.55) end },
		{ "Big Head", function(c, ch, h, pv) FX.head(c, ch, h, pv, 2.2) end },
		{ "Tiny Head", function(c, ch, h, pv) FX.head(c, ch, h, pv, 0.5) end },
		skin("Ghost", rgb(200, 225, 255), M.ForceField, 0.55, true),
		skin("Neon", rgb(60, 255, 200), M.Neon),
		skin("Gold", rgb(255, 196, 40), M.Metal),
		skin("Skeleton", rgb(238, 236, 222), M.SmoothPlastic),
		skin("Shadow", rgb(12, 12, 14), M.SmoothPlastic),
		skin("Ice", rgb(170, 225, 255), M.Ice, 0.15),
		skin("Lava", rgb(255, 90, 20), M.Neon),
		skin("Robot", rgb(130, 140, 150), M.Metal),
		skin("Zombie", rgb(110, 150, 90), M.Plastic),
		skin("Alien", rgb(120, 255, 90), M.SmoothPlastic),
		skin("Stone", rgb(110, 110, 115), M.Slate),
		skin("Invisible", nil, nil, 1, true),
		skin("Glass", rgb(190, 235, 255), M.Glass, 0.5, true),
		skin("Slime", rgb(90, 255, 120), M.Neon, 0.35),
		skin("Hologram", rgb(60, 200, 255), M.Neon, 0.45, true),
		skin("Void", rgb(20, 0, 40), M.Glass, 0.1),
		skin("Diamond", rgb(185, 242, 255), M.Glass, 0.2),
		{ "Wide", function(c, ch, h)
			FX.nscale(c, h, "BodyWidthScale", 1.6)
			FX.nscale(c, h, "BodyDepthScale", 1.4)
		end },
		{ "Skinny", function(c, ch, h)
			FX.nscale(c, h, "BodyWidthScale", 0.6)
			FX.nscale(c, h, "BodyDepthScale", 0.7)
		end },
		{ "Tall", function(c, ch, h)
			if not FX.nscale(c, h, "BodyHeightScale", 1.35) then
				FX.uni(c, ch, 1.3)
			end
		end },
		{ "Short", function(c, ch, h)
			if not FX.nscale(c, h, "BodyHeightScale", 0.7) then
				FX.uni(c, ch, 0.7)
			end
		end },
		{ "Rainbow", function(c, ch)
			local ps = FX.parts(ch, false)
			for _, p in ipairs(ps) do
				P(c, p, "Color", p.Color)
				P(c, p, "Material", M.Neon)
			end
			local t = 0
			table.insert(c.conns, RunService.Heartbeat:Connect(function(dt)
				t = t + dt * 0.25
				for i, p in ipairs(ps) do
					if p.Parent then
						p.Color = Color3.fromHSV((t + i * 0.04) % 1, 0.9, 1)
					end
				end
			end))
		end },
	}
	for _, cn in ipairs(HE.ColorNames) do
		table.insert(pool, skin(cn .. " Skin", ColorMap[cn:lower()], M.SmoothPlastic))
	end
	local mats = { M.Neon, M.Metal, M.Glass, M.ForceField, M.SmoothPlastic, M.Ice, M.Marble, M.Granite }
	local out = {}
	for i = 1, count do
		if pool[i] then
			out[i] = pool[i]
		else
			local n = i - #pool
			local mat = mats[(n % #mats) + 1]
			out[i] = skin("Mix " .. n, Color3.fromHSV((n * 0.137) % 1, 0.75, 1), mat, (mat == M.Glass) and 0.35 or nil)
		end
	end
	return out
end

-- Purple trails: both shoulders, both hands, both knees (fade out gradually)
function FX.trails(char, color)
	local out = {}
	local r15 = char:FindFirstChild("LeftHand") ~= nil
	local spots = r15 and {
		{ "LeftUpperArm", "top" }, { "RightUpperArm", "top" }, { "LeftHand", "mid" },
		{ "RightHand", "mid" }, { "LeftLowerLeg", "top" }, { "RightLowerLeg", "top" },
	} or {
		{ "Left Arm", "top" }, { "Right Arm", "top" }, { "Left Arm", "bottom" },
		{ "Right Arm", "bottom" }, { "Left Leg", "mid" }, { "Right Leg", "mid" },
	}
	for _, s in ipairs(spots) do
		local part = char:FindFirstChild(s[1])
		if part and part:IsA("BasePart") then
			local y = 0
			if s[2] == "top" then
				y = part.Size.Y / 2 - 0.15
			elseif s[2] == "bottom" then
				y = -part.Size.Y / 2 + 0.2
			end
			local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
			a0.Position, a1.Position = Vector3.new(0, y + 0.25, 0), Vector3.new(0, y - 0.25, 0)
			a0.Parent, a1.Parent = part, part
			local t = Instance.new("Trail")
			t.Attachment0, t.Attachment1 = a0, a1
			t.Lifetime, t.MinLength, t.FaceCamera = 0.75, 0.02, true
			t.LightEmission, t.LightInfluence = 1, 0
			t.Color = ColorSequence.new(color, color:Lerp(rgb(70, 10, 150), 0.6))
			t.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
			t.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.15) })
			t.Parent = part
			table.insert(out, a0)
			table.insert(out, a1)
			table.insert(out, t)
		end
	end
	return out
end

function Elements:CreateEffects(o)
	o = o or {}
	local win, tabRef = self.Window, self
	local count = math.floor(Guard.Num(o.Count, 30, 1, 300))
	local trailColor = HE.GetColor(o.TrailColor) or rgb(165, 80, 255)
	local defs = FX.defs(count)
	local names, byName = {}, {}
	for i, d in ipairs(defs) do
		names[i] = d[1]
		byName[d[1]] = i
	end

	local card = New("Frame", { BackgroundColor3 = State.Theme.Element, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
	bind(card, "BackgroundColor3", "Element")
	corner(card, R_ROW)
	stroke(card, WHITE, 1, 0.94)
	pad(card, 10, 10, 10, 10)
	list(card, 8, Enum.FillDirection.Vertical, Enum.HorizontalAlignment.Center)
	local title = New("TextLabel", {
		Size = UDim2.new(1, 0, 0, 16), Text = string.format("AVATAR EFFECTS  |  %d", count), Font = FONT_BOLD, TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 1, Parent = card,
	})
	bind(title, "TextColor3", "Accent")

	local SQ = 160
	local square = New("Frame", { BackgroundColor3 = State.Theme.Panel, Size = UDim2.fromOffset(SQ, SQ), LayoutOrder = 2, Parent = card })
	bind(square, "BackgroundColor3", "Panel")
	corner(square, R_CARD)
	stroke(square, WHITE, 1, 0.85)
	local vpf = New("ViewportFrame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = square })
	vpf.Ambient, vpf.LightColor = rgb(190, 190, 200), rgb(255, 255, 255)
	corner(vpf, R_CARD)
	local nameLbl = New("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -4), Size = UDim2.new(1, -8, 0, 14),
		Text = "No effect", Font = FONT_BOLD, TextSize = 10, Parent = square,
	})
	bind(nameLbl, "TextColor3", "SubText")

	local cur, ctx, pctx, pmodel, trailObjs, ang = nil, nil, nil, nil, {}, 0
	local function getChar()
		return LocalPlayer and LocalPlayer.Character
	end

	local function frameCamera()
		if not (pmodel and pmodel.Parent) then
			return
		end
		pmodel:PivotTo(CFrame.new())
		local cf, size = pmodel:GetBoundingBox()
		local cam = vpf.CurrentCamera
		if not cam then
			cam = Instance.new("Camera")
			cam.Parent = vpf
			vpf.CurrentCamera = cam
		end
		cam.FieldOfView = 30
		local dist = math.max(size.Y, size.X) * 2.15 + size.Z * 0.5
		local c = Vector3.new(0, cf.Position.Y, 0)
		cam.CFrame = CFrame.lookAt(c + Vector3.new(0, 0, -dist), c)
		pmodel:PivotTo(CFrame.Angles(0, ang, 0))
	end

	local function revert()
		if ctx then
			FX.undo(ctx)
			ctx = nil
		end
		if pctx then
			FX.undo(pctx)
			pctx = nil
		end
	end

	local function removeTrails()
		for _, x in ipairs(trailObjs) do
			pcall(function()
				x:Destroy()
			end)
		end
		trailObjs = {}
	end

	local function apply(i)
		revert()
		cur = i
		local def = defs[i]
		if not def then
			return
		end
		local char = getChar()
		if char and char.Parent then
			ctx = FX.newCtx()
			pcall(def[2], ctx, char, char:FindFirstChildOfClass("Humanoid"), false)
			removeTrails()
			trailObjs = FX.trails(char, trailColor)
		end
		if pmodel and pmodel.Parent then
			pctx = FX.newCtx()
			pcall(def[2], pctx, pmodel, pmodel:FindFirstChildOfClass("Humanoid"), true)
			frameCamera()
		end
		nameLbl.Text = def[1]
	end

	local function buildPreview()
		if pctx then
			FX.undo(pctx)
			pctx = nil
		end
		if pmodel then
			pmodel:Destroy()
			pmodel = nil
		end
		local char = getChar()
		if not char then
			return
		end
		local was = char.Archivable
		char.Archivable = true
		local ok, clone = pcall(function()
			return char:Clone()
		end)
		char.Archivable = was
		if not ok or not clone then
			return
		end
		for _, d in ipairs(clone:GetDescendants()) do
			if d:IsA("LuaSourceContainer") or d:IsA("Sound") or d:IsA("Trail") or d:IsA("ParticleEmitter") then
				d:Destroy()
			elseif d:IsA("BasePart") then
				d.Anchored = true
			end
		end
		local hum = clone:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		end
		clone.PrimaryPart = clone:FindFirstChild("HumanoidRootPart") or clone:FindFirstChild("Head")
		local wm = vpf:FindFirstChildOfClass("WorldModel")
		if not wm then
			wm = Instance.new("WorldModel")
			wm.Parent = vpf
		end
		clone.Parent = wm
		pmodel = clone
		frameCamera()
		if cur and defs[cur] then
			pctx = FX.newCtx()
			pcall(defs[cur][2], pctx, pmodel, pmodel:FindFirstChildOfClass("Humanoid"), true)
			frameCamera()
		end
	end

	local function clear()
		revert()
		removeTrails()
		cur = nil
		nameLbl.Text = "No effect"
		frameCamera()
	end

	-- dropdown + reset button live INSIDE the card, under the square
	local host = setmetatable({ Window = win, Items = {}, Kind = "Host", Page = self.Page }, PanelMT)
	function host:_Add(frame, name, kind)
		table.insert(self.Items, frame)
		frame.LayoutOrder = 10 + #self.Items
		frame.Parent = card
		table.insert(win.Elements, { Name = name or "Element", Kind = kind, Tab = tabRef, Frame = frame })
	end
	function host:_SetScrolling(b)
		tabRef:_SetScrolling(b)
	end
	local dd = host:CreateDropdown({
		Name = o.Name or "Effect", Description = "Every effect also adds the purple trails.", Options = names, Search = true,
		Flag = o.Flag or "AvatarEffect",
		Callback = function(v)
			if v and byName[v] then
				apply(byName[v])
			end
		end,
	})
	host:CreateButton({
		Name = "Remove effect", Description = "Clears the effect and the purple trails.",
		Callback = function()
			clear()
			dd.Set(nil, true)
		end,
	})
	self:_Add(card, "Avatar Effects", "Effects")

	connect(RunService.Heartbeat, function(dt)
		if pmodel and pmodel.Parent and win.Visible and tabRef.Page and tabRef.Page.Visible then
			ang = ang + dt * 0.9
			pmodel:PivotTo(CFrame.Angles(0, ang, 0))
		end
	end)
	if LocalPlayer then
		connect(LocalPlayer.CharacterAdded, function()
			ctx, trailObjs = nil, {}
			task.wait(1)
			if not card.Parent then
				return
			end
			buildPreview()
			if cur then
				apply(cur)
			end
		end)
	end
	table.insert(Cleanups, function()
		revert()
		removeTrails()
		if pmodel then
			pmodel:Destroy()
		end
	end)
	task.defer(buildPreview)
	return { Frame = card, Apply = apply, Clear = clear, Count = count, Names = names }
end

