-- Modern text measuring (falls back to the legacy API if unavailable)
local function measure(text, size, font, width)
	width = width or 10000
	local ok, res = pcall(function()
		local p = Instance.new("GetTextBoundsParams")
		p.Text = text
		p.Font = Font.fromEnum(font)
		p.Size = size
		p.Width = width
		return TextService:GetTextBoundsAsync(p)
	end)
	if ok and typeof(res) == "Vector2" then
		return res
	end
	local ok2, res2 = pcall(function()
		return TextService:GetTextSize(text, size, font, Vector2.new(width, 10000))
	end)
	if ok2 and typeof(res2) == "Vector2" then
		return res2
	end
	return Vector2.new(#text * size * 0.55, size)
end

