-- ---------- Color picker ----------
function Elements:CreateColorPicker(o)
	o = o or {}
	local win = self.Window
	local row = buildRow(self, o, 44)
	local color = o.Default or State.Accent
	local h, s, v = color:ToHSV()
	local swatch = New("Frame", { BackgroundColor3 = color, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(28, 22), Parent = row })
	corner(swatch, R_SMALL)
	stroke(swatch, WHITE, 1, 0.6)
	local hit = New("TextButton", { Size = UDim2.fromScale(1, 1), ZIndex = 2, Parent = row })
	hoverFx(hit, row)
	rippleOn(hit, row)

	local function toHex(c)
		return string.format("#%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
	end
	local ui = {}
	local function refreshUI()
		swatch.BackgroundColor3 = color
		if ui.sv then
			ui.sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
			ui.svCur.Position = UDim2.fromScale(s, 1 - v)
			ui.hueCur.Position = UDim2.fromScale(h, 0.5)
			ui.hex.Text = toHex(color)
		end
	end
	local function setColor(c, silent)
		if type(c) == "table" and c.__color then
			c = Color3.new(c.__color[1], c.__color[2], c.__color[3])
		end
		if typeof(c) ~= "Color3" then
			return
		end
		color = c
		h, s, v = c:ToHSV()
		refreshUI()
		if not silent then
			safeCall(o.Callback, color)
			win:_Changed()
		end
	end
	local function fromHSV()
		color = Color3.fromHSV(h, s, v)
		refreshUI()
		safeCall(o.Callback, color)
		win:_Changed()
	end

	local isOpen, closeFn = false, nil
	hit.Activated:Connect(function()
		if isOpen then
			if closeFn then
				closeFn()
			end
			return
		end
		isOpen = true
		local bag = {}
		local catcher = New("TextButton", { Size = UDim2.fromScale(1, 1), ZIndex = 200, Parent = win.Gui })
		local abs, sz = row.AbsolutePosition, row.AbsoluteSize
		local w, hgt = 214, 178
		local vp = win.Gui.AbsoluteSize
		local y = abs.Y + sz.Y + 4
		if y + hgt > vp.Y - 6 then
			y = abs.Y - hgt - 4
		end
		y = math.clamp(y, 6, math.max(6, vp.Y - hgt - 6))
		local x = math.clamp(abs.X + sz.X - w, 6, math.max(6, vp.X - w - 6))
		local popup = New("Frame", { BackgroundColor3 = State.Theme.Panel, Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, 0), ClipsDescendants = true, ZIndex = 201, Parent = win.Gui })
		corner(popup, R_CARD)
		stroke(popup, WHITE, 1, 0.9)
		tw(popup, 0.22, { Size = UDim2.fromOffset(w, hgt) })
		local sv = New("Frame", { BackgroundColor3 = Color3.fromHSV(h, 1, 1), Position = UDim2.fromOffset(10, 10), Size = UDim2.fromOffset(194, 100), ClipsDescendants = true, Active = true, Parent = popup })
		corner(sv, R_BTN)
		local wh = New("Frame", { BackgroundColor3 = WHITE, Size = UDim2.fromScale(1, 1), Parent = sv })
		New("UIGradient", { Transparency = NumberSequence.new(0, 1), Parent = wh })
		local bk = New("Frame", { BackgroundColor3 = BLACK, Size = UDim2.fromScale(1, 1), Parent = sv })
		New("UIGradient", { Transparency = NumberSequence.new(1, 0), Rotation = 90, Parent = bk })
		local svCur = New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(12, 12), Position = UDim2.fromScale(s, 1 - v), Parent = sv })
		svCur.BackgroundTransparency = 1
		corner(svCur, 6)
		stroke(svCur, WHITE, 1.5, 0)
		local hue = New("Frame", { BackgroundColor3 = WHITE, Position = UDim2.fromOffset(10, 118), Size = UDim2.fromOffset(194, 12), Active = true, Parent = popup })
		corner(hue, 6)
		New("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, rgb(255, 0, 0)), ColorSequenceKeypoint.new(0.17, rgb(255, 255, 0)),
				ColorSequenceKeypoint.new(0.33, rgb(0, 255, 0)), ColorSequenceKeypoint.new(0.5, rgb(0, 255, 255)),
				ColorSequenceKeypoint.new(0.67, rgb(0, 0, 255)), ColorSequenceKeypoint.new(0.83, rgb(255, 0, 255)),
				ColorSequenceKeypoint.new(1, rgb(255, 0, 0)),
			}),
			Parent = hue,
		})
		local hueCur = New("Frame", { BackgroundColor3 = WHITE, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(h, 0.5), Size = UDim2.fromOffset(6, 18), Parent = hue })
		corner(hueCur, 3)
		local hbg = New("Frame", { BackgroundColor3 = State.Theme.Element, Position = UDim2.fromOffset(10, 140), Size = UDim2.fromOffset(194, 28), Parent = popup })
		corner(hbg, R_BTN)
		local hex = New("TextBox", { Size = UDim2.fromScale(1, 1), Text = toHex(color), TextSize = 12, Font = Enum.Font.Code, Parent = hbg })
		ui.sv, ui.svCur, ui.hueCur, ui.hex = sv, svCur, hueCur, hex
		trackPointer(sv, function(pos)
			s = math.clamp((pos.X - sv.AbsolutePosition.X) / math.max(sv.AbsoluteSize.X, 1), 0, 1)
			v = 1 - math.clamp((pos.Y - sv.AbsolutePosition.Y) / math.max(sv.AbsoluteSize.Y, 1), 0, 1)
			fromHSV()
		end, nil, nil, bag)
		trackPointer(hue, function(pos)
			h = math.clamp((pos.X - hue.AbsolutePosition.X) / math.max(hue.AbsoluteSize.X, 1), 0, 0.999)
			fromHSV()
		end, nil, nil, bag)
		connect(hex.FocusLost, function()
			local okc, c = pcall(Color3.fromHex, hex.Text)
			if okc and c then
				setColor(c)
			else
				hex.Text = toHex(color)
			end
		end, bag)
		closeFn = function()
			if not isOpen then
				return
			end
			isOpen = false
			clearBag(bag)
			ui.sv = nil
			tw(popup, 0.18, { Size = UDim2.fromOffset(w, 0) })
			catcher:Destroy()
			task.delay(0.2, function()
				popup:Destroy()
			end)
		end
		catcher.Activated:Connect(closeFn)
	end)
	win:_Flag(o.Flag or o.Name, function()
		return color
	end, setColor)
	self:_Add(row, o.Name or "Color Picker", "ColorPicker")
	return { Frame = row, Set = setColor, Get = function() return color end }
end

