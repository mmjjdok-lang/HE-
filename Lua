local AssetService = game:GetService("AssetService")
local TITLE_ICON_SIZE = 32

local function fitImage(img, opts)
	opts = opts or {}
	img.ScaleType = Enum.ScaleType.Fit
	if opts.Size then
		img.Size = opts.Size
	end
	if opts.Crop == false or img.ImageRectSize ~= Vector2.new(0, 0) then
		return
	end
	local id = type(img.Image) == "string" and img.Image:match("^rbxassetid://(%d+)$")
	if not id then
		return
	end
	task.spawn(function()
		local ok, x0, y0, x1, y1, iw, ih = pcall(function()
			local ei = AssetService:CreateEditableImageAsync(Content.fromAssetId(tonumber(id)))
			local sz = ei.Size
			local w, h = sz.X, sz.Y
			if w < 1 or h < 1 or w * h > 1024 * 1024 then
				ei:Destroy()
				return nil
			end
			local buf = ei:ReadPixelsBuffer(Vector2.new(0, 0), sz)
			ei:Destroy()
			local step = (w * h > 512 * 512) and 2 or 1
			local minX, minY, maxX, maxY = w, h, -1, -1
			for y = 0, h - 1, step do
				for x = 0, w - 1, step do
					if buffer.readu8(buf, (y * w + x) * 4 + 3) > 16 then
						if x < minX then
							minX = x
						end
						if y < minY then
							minY = y
						end
						if x > maxX then
							maxX = x
						end
						if y > maxY then
							maxY = y
						end
					end
				end
				if y % 64 == 0 then
					task.wait()
				end
			end
			if maxX < minX or maxY < minY then
				return nil
			end
			return minX, minY, math.min(w - 1, maxX + step - 1), math.min(h - 1, maxY + step - 1), w, h
		end)
		if not ok or not x0 or not img.Parent then
			return
		end
		local bw, bh = x1 - x0 + 1, y1 - y0 + 1
		if bw * bh < iw * ih * 0.92 then
			img.ImageRectOffset = Vector2.new(x0, y0)
			img.ImageRectSize = Vector2.new(bw, bh)
		end
	end)
end

