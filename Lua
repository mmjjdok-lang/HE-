		win._folderClose = nil
		tw(popup, 0.16, { Size = UDim2.fromOffset(width, 0) })
		catcher:Destroy()
		task.delay(0.18, function()
			popup:Destroy()
		end)
	end
	win._folderClose = close
	catcher.Activated:Connect(close)

	local function build()
		for _, c in ipairs(scroll:GetChildren()) do
			if c:IsA("GuiObject") then
				c:Destroy()
			end
		end
		if #win.FolderList == 0 then
			New("TextLabel", { Size = UDim2.new(1, 0, 0, 26), Text = "No folders yet.", TextSize = 11, TextColor3 = State.Theme.SubText, Parent = scroll })
		end
		for i, fname in ipairs(win.FolderList) do
			local item = New("Frame", { BackgroundColor3 = State.Theme.Element, Size = UDim2.new(1, -4, 0, 28), LayoutOrder = i, Parent = scroll })
			corner(item, R_SMALL)
			New("TextLabel", {
				Position = UDim2.fromOffset(8, 0), Size = UDim2.new(1, -72, 1, 0), Text = fname, TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd, TextSize = 12, TextColor3 = State.Theme.Text, Parent = item,
			})
			local del = New("TextButton", {
				BackgroundTransparency = 0, BackgroundColor3 = State.Theme.Panel, AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -34, 0.5, 0), Size = UDim2.fromOffset(26, 22), Text = "🗑", TextSize = 13, Parent = item,
			})
			corner(del, R_SMALL)
			local use = New("TextButton", {
				BackgroundTransparency = 0, BackgroundColor3 = State.Theme.Panel, AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -4, 0.5, 0), Size = UDim2.fromOffset(26, 22), Text = "✓", Font = FONT_BOLD, TextSize = 14,
				TextColor3 = State.Accent, Parent = item,
			})
			corner(use, R_SMALL)
			del.Activated:Connect(function()
				playSound()
				win:DeleteFolder(fname)
				build()
				layout()
			end)
			use.Activated:Connect(function()
				playSound()
				close()
				win:LoadFolder(fname)
			end)
