		getKey.Position = UDim2.new(0.5, 3, 1, -52)
		getKey.Size = UDim2.new(0.5, -21, 0, 36)
		getKey.Activated:Connect(function()
			HE:Copy(cfg.Link, "Key link")
		end)
	else
		verify.Position = UDim2.new(0, 18, 1, -52)
		verify.Size = UDim2.new(1, -36, 0, 36)
	end
	local close = New("TextButton", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 12), Size = UDim2.fromOffset(26, 26), Text = "X", Font = FONT_BOLD, TextColor3 = State.Theme.SubText, Parent = card })
	close.Activated:Connect(function()
		done, result = true, false
	end)
	verify.Activated:Connect(function()
		playSound()
		local typed = input.Text:gsub("^%s+", ""):gsub("%s+$", "")
		if valid(typed) then
			if cfg.SaveKey and typeof(writefile) == "function" then
				pcall(writefile, saveFile, typed)
			end
			done, result = true, true
		else
			msg.Text = "Invalid key. Please try again."
			for i = 1, 4 do
				tw(card, 0.04, { Position = UDim2.new(0.5, (i % 2 == 0) and 8 or -8, 0.5, 0) })
				task.wait(0.05)
			end
			tw(card, 0.08, { Position = UDim2.fromScale(0.5, 0.5) })
		end
	end)
	repeat
		task.wait(0.1)
	until done
	tw(sc, 0.2, { Scale = 0.9 })
	tw(root, 0.2, { BackgroundTransparency = 1 })
	task.wait(0.2)
	root:Destroy()
	return result
end

