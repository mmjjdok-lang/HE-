	local btn = New("TextButton", { Size = UDim2.fromScale(1, 1), Parent = card })
	tw(card, 0.4, { Position = UDim2.new(0, 0, 0, 0) }, Enum.EasingStyle.Back)
	tw(bar, dur, { Size = UDim2.new(0, 0, 0, 2) }, Enum.EasingStyle.Linear)
	local gone = false
	local function dismiss()
		if gone then
			return
		end
		gone = true
		tw(card, 0.3, { Position = UDim2.new(1, 60, 0, 0) })
		task.wait(0.3)
		if not outer.Parent then
			return
		end
		outer.AutomaticSize = Enum.AutomaticSize.None
		tw(outer, 0.2, { Size = UDim2.new(1, 0, 0, 0) })
		task.wait(0.22)
		outer:Destroy()
	end
	btn.Activated:Connect(function()
		task.spawn(dismiss)
	end)
	task.delay(dur, function()
		task.spawn(dismiss)
	end)
end

